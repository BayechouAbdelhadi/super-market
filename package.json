{
    "name": "super-market",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "worker:dev": "tsx watch --env-file=.env worker/index.ts",
        "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --external:pg-native --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
        "worker": "node dist/worker.mjs",
        "lint": "eslint",
        "test": "vitest run",
        "create-vps-key": "bash ./create-vps-key.sh super-market",
        "fb:posts": "node scripts/get-facebook-posts.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.117.2",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lucide-react": "^1.52.0",
        "next": "16.3.8",
        "pg-boss": "12.36.0",
        "qrcode": "^1.5.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "^4.21.4",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^22.20.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "esbuild": "0.28.2",
        "eslint": "^9",
        "eslint-config-next": "16.3.8",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.0.3"
    }
}
