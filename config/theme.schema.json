                "description": "Readable text on the gold tint"
              }
            },
            "additionalProperties": false
          },
          "radius": {
            "description": "Corner radii",
            "type": "object",
            "properties": {
              "button": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(px|rem)$",
                "description": "Corner radius of buttons"
              },
              "input": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(px|rem)$",
                "description": "Corner radius of inputs"
              },
              "card": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(px|rem)$",
                "description": "Corner radius of cards"
              },
              "dialog": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(px|rem)$",
                "description": "Corner radius of dialogs and large containers"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
